{
  "name": "alumex-quotation-system",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3003",
    "build": "next build",
    "start": "next start -p 3003",
    "lint": "eslint",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "test:sales-foundation": "node --experimental-strip-types --test tests/sales-foundation.test.mjs",
    "test:database": "node --test tests/database/rls.integration.mjs",
